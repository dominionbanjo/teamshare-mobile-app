# TeamShare Mobile — environment variables (all optional; defaults shown)
# Copy to .env.local for local overrides.
#
# On a physical device, replace localhost with your machine's LAN IP, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
#   EXPO_PUBLIC_WS_URL=http://192.168.1.10:4000

# REST API base URL (teamshare-backend, NestJS). No path prefix - the backend
# serves at the root (api.domain.com/).
EXPO_PUBLIC_API_URL=http://localhost:4000

# Socket.IO origin for realtime project chat (no /api prefix).
EXPO_PUBLIC_WS_URL=http://localhost:4000
